# Variables the server's /opt/stack/.env must define. Ansible writes it from
# Ansible Vault (ansible/roles/stack/templates/env.j2); never edit it by hand.

# Password of the postgres superuser.
POSTGRES_PASSWORD=

# life-app: its Postgres role's password, the URL built from it, and the
# comma-separated Google OAuth Web client IDs the API accepts.
LIFE_APP_DB_PASSWORD=
LIFE_APP_DATABASE_URL=postgres://life_app:<password>@postgres:5432/life_app?sslmode=disable
LIFE_APP_GOOGLE_CLIENT_IDS=
