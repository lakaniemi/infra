{
	servers {
		# HTTP/3 runs over UDP, which the Hetzner firewall doesn't allow.
		protocols h1 h2
	}
}

# Placeholder until the personal website exists. The redirect is temporary
# so browsers don't cache it in case www becomes the main address.
lakaniemi.com {
	respond 200
}

www.lakaniemi.com {
	redir https://lakaniemi.com{uri}
}

webhooks.lakaniemi.com {
	# The listener never reads request bodies.
	request_body {
		max_size 1KB
	}
	reverse_proxy webhooks:8080
}

# TEMPORARY: remove after the ryijypalvelu migration.
# Caddy resolves the upstream per request, so it starts even while the
# ryijypalvelu-demo container doesn't exist; requests then get a 502.
ryijypalvelu-demo.lakaniemi.com {
	basic_auth {
		{$RYIJY_DEMO_BASIC_AUTH_USER} {$RYIJY_DEMO_BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
	request_body {
		max_size 64MB
	}
	reverse_proxy ryijypalvelu-demo:80
}

life-app-api.lakaniemi.com {
	reverse_proxy life-app-api:8080 {
		# Holds requests while the API restarts instead of returning errors.
		lb_try_duration 5s
	}
}
