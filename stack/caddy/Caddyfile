{
	servers {
		# HTTP/3 runs over UDP, which the Hetzner firewall doesn't allow.
		protocols h1 h2
	}
}

webhooks.lakaniemi.com {
	# The listener never reads request bodies.
	request_body {
		max_size 1KB
	}
	reverse_proxy webhooks:8080
}

life-app-api.lakaniemi.com {
	reverse_proxy life-app-api:8080 {
		# Holds requests while the API restarts instead of returning errors.
		lb_try_duration 5s
	}
}
